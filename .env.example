# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ── Supabase (обязательно для production) ─────────────────────────────────────
# URL проекта (например: https://xxxxx.supabase.co)
SUPABASE_URL=your_supabase_url_here
# Публичный ключ (anon key) из Settings > API
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Токен API ФНС для проверки ИНН (https://api-fns.ru)
FNS_API_TOKEN=your_fns_api_token_here

# Токен API Яндекс.Геокодер (https://developer.tech.yandex.ru)
YANDEX_GEO_TOKEN=your_yandex_geocoder_token_here

# ID администратора бота (Telegram user_id)
ADMIN_ID=123456789

# Путь к базе данных SQLite (только для локальной разработки)
DB_PATH=waste_bot.db

# Путь для хранения документов
DOCS_PATH=documents/

# ── Redis для FSM (опционально) ─────────────────────────────────────────────
# USE_REDIS=true  # использовать Redis вместо MemoryStorage
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=